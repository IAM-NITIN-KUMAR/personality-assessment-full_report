# Anthropic API key — used for adaptive probe questions.
# Get one at https://console.anthropic.com/. If left blank, the app falls back
# to deterministic next-question routing so the demo still runs.
ANTHROPIC_API_KEY=

# Optional: pin the model used for probes. Defaults to claude-sonnet-4-5 if unset.
ANTHROPIC_PROBE_MODEL=claude-sonnet-4-5
