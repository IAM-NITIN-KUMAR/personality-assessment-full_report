        "branching_logic": {
          "continue_to_abroad_questions_if": [
            "a",
            "c"
          ],
          "end_test_if": [
            "b",
            "no_selection",
            "invalid_or_unanswered"
          ],
          "on_end_test": {
            "action": "terminate_assessment_immediately",
