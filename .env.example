# Supabase project URL and anon (public) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Access codes (server-only; never expose with NEXT_PUBLIC_) ---
# Supabase → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=
# Password for /admin (pick a long one)
ADMIN_PASSWORD=
# Random secret for signing admin session cookies, e.g.: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# --- Ask the Gita (the chat at the end of the web report; server-only) ---
# Google Gemini key (https://aistudio.google.com/apikey). It writes the answers and searches the verses.
# Leave empty to hide the section. Other settings (model, daily caps) are listed in lib/v2/gita/service.ts.
GEMINI_API_KEY=
