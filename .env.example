# Supabase project URL and anon (public) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Access codes (server-only; never expose with NEXT_PUBLIC_) ---
# Supabase → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=
# Password for /admin (pick a long one)
ADMIN_PASSWORD=
# Random secret for signing admin session cookies, e.g.: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# --- Ask the Gita (the chat at the end of the web report; server-only) ---
# Base URL of the Gita chat service (THE GITA PROJECT, python -m scripture_rag.web).
# Leave empty in production to hide the section. In development it defaults to http://127.0.0.1:8000.
GITA_API_URL=
# Optional shared secret; must match GITA_SHARED_SECRET on the service.
GITA_API_SECRET=
